diff --git a/glworia/pe/waveform.py b/glworia/pe/waveform.py
index 2a1f0ee..175510b 100644
--- a/glworia/pe/waveform.py
+++ b/glworia/pe/waveform.py
@@ -15,6 +15,16 @@ from scipy.constants import c, G
 Msun = 1.9884099e+30
 Mtow = 8*np.pi*G/c**3*Msun
 
+# Local fix (2026-10-08): F(w) is computed with the e^{+iwT} convention, while LAL waveforms use
+# h(f) = int h(t) e^{-2 pi i f t} dt. The lensed LAL waveform is therefore conj(F) * h, which puts
+# later images later in time. 'lal' (default) applies conj(F); 'glworia' keeps the released behaviour.
+def to_fourier_convention(Fs, fourier_convention):
+    if fourier_convention == 'lal':
+        return np.conj(Fs)
+    if fourier_convention != 'glworia':
+        raise ValueError("fourier_convention must be 'lal' or 'glworia'")
+    return Fs
+
 from ..amp.load_interp import *
 
 def lal_binary_black_hole_lensed(
@@ -23,7 +33,8 @@ def lal_binary_black_hole_lensed(
 
     ws = frequency_array*Mtow*MLz
     F_interp = kwargs['F_interp']
-    Fs = F_interp(ws, y, lp)
+    fourier_convention = kwargs.pop('fourier_convention', 'lal')
+    Fs = to_fourier_convention(F_interp(ws, y, lp), fourier_convention)
     del kwargs['F_interp']
     waveform_kwargs = dict(
         waveform_approximant='IMRPhenomXAS', reference_frequency=50.0,
@@ -83,7 +94,8 @@ def lal_binary_black_hole_lensed_relative_binning(
             phi_12=phi_12, lambda_1=0.0, lambda_2=0.0, **waveform_kwargs)
         ws = waveform_kwargs["frequencies"]*Mtow*MLz
     F_interp = kwargs['F_interp']
-    Fs = F_interp(ws, y, lp)
+    fourier_convention = kwargs.pop('fourier_convention', 'lal')
+    Fs = to_fourier_convention(F_interp(ws, y, lp), fourier_convention)
     del kwargs['F_interp']
     waveform_dict["plus"] *= Fs
     waveform_dict["cross"] *= Fs
